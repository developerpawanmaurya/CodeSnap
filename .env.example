# Required for AI semantic search.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Embedding model. text-embedding-3-small is fast & cheap (1536 dims).
# Alternatives: text-embedding-3-large (3072 dims, more accurate)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Path to the JSON store file. Created automatically on first run.
DATABASE_PATH=./data/codesnap.json

# Optional: disable embeddings (search will fall back to keyword match)
# DISABLE_EMBEDDINGS=true

# Optional: GitHub personal access token. Without it, public-repo imports work
# but you're capped at 60 GitHub API requests per hour. With a token, the cap
# rises to 5000/hour and you can also import private repos you have access to.
# Create at https://github.com/settings/tokens (just `repo` scope is enough).
# GITHUB_TOKEN=ghp_...
